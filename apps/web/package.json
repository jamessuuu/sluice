{
  "name": "@jamessuuu/sluice-web",
  "private": true,
  "version": "0.0.0",
  "description": "sluice docs + interactive playground (Next.js). Zero API routes, zero database, zero writes — SPEC §9.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "pnpm run build:deps",
    "dev": "next dev",
    "prebuild": "pnpm run build:deps",
    "build": "next build",
    "build:deps": "pnpm --filter @jamessuuu/sluice --filter @jamessuuu/sluice-testkit run build",
    "start": "next start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "record-demo": "node ../../scripts/record-demo.mjs --project=sluice --out=public/demo"
  },
  "dependencies": {
    "@jamessuuu/sluice": "workspace:^",
    "@jamessuuu/sluice-testkit": "workspace:^",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "16.3.0",
    "next": "16.3.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "tailwindcss": "^4.3.3"
  }
}
