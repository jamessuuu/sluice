{
  "name": "@jamessuuu/sluice-testkit",
  "version": "1.0.0-rc.1",
  "description": "Deterministic chaos harness for @jamessuuu/sluice: fake transport, fault plans, virtual clock, crash controller, store conformance suite.",
  "license": "MIT",
  "author": "James Lorenz Santos",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamessuuu/sluice.git",
    "directory": "packages/sluice-testkit"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.ts",
    "./chaos": "./src/chaos/suite.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./chaos": {
        "types": "./dist/chaos/suite.d.ts",
        "default": "./dist/chaos/suite.js"
      }
    }
  },
  "files": [
    "dist",
    "golden",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@jamessuuu/sluice": "workspace:^"
  }
}
