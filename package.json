{
  "name": "sluice-monorepo",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm -r --parallel typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "pnpm -r build",
    "chaos": "node --import tsx packages/sluice-testkit/src/chaos/run.ts && node scripts/chaos-report.mjs",
    "chaos:goldens": "node --import tsx packages/sluice-testkit/src/chaos/generate-goldens.ts",
    "eval": "vitest run --project eval",
    "ci:pack-check": "node scripts/pack-check.mjs",
    "brand": "node scripts/brand.mjs --project=sluice --out=apps/web/public/brand",
    "diagram": "node scripts/diagram.mjs --out=apps/web/public/diagram",
    "test:e2e": "pnpm --filter @jamessuuu/sluice-web run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@jamessuuu/sluice": "workspace:^",
    "@jamessuuu/sluice-testkit": "workspace:^",
    "@types/node": "^22.10.0",
    "eslint": "^9.20.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^4.1.10",
    "next": "^16.3.0"
  }
}
