{
  "name": "@jamessuuu/sluice-store-postgres",
  "version": "1.0.0-rc.1",
  "description": "Postgres/Neon store adapter for @jamessuuu/sluice (Drizzle, forward-only migrations, single-statement operations).",
  "license": "MIT",
  "author": "James Lorenz Santos",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamessuuu/sluice.git",
    "directory": "packages/sluice-store-postgres"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "migrations",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "db:seed": "node --import tsx scripts/seed.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2"
  },
  "peerDependencies": {
    "@jamessuuu/sluice": "workspace:^"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.4",
    "@jamessuuu/sluice": "workspace:^",
    "@jamessuuu/sluice-testkit": "workspace:^",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.5",
    "pg": "^8.13.1",
    "tsx": "^4.19.2"
  }
}
